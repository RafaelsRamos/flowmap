{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": ["src"],
  "references": [{ "path": "../core" }, { "path": "../adapters" }]
}
