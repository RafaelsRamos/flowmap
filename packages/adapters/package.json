{
  "name": "@flowmap/adapters",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Log backends for Flowmap: each turns its records into normalised events (log files, Loki)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@flowmap/core": "*"
  }
}
